+import pathlib,json,collections,bisect,re
+R=pathlib.Path.cwd();O=R/'measurements/trim';NO=2**64-1;total=0;count=0
+for p in sorted(O.iterdir()):
+ if not(p/'analysis.json').exists():continue
+ r=json.loads((p/'analysis.json').read_text())
+ if'wrote pruned'not in r['artifact']:continue
+ m=json.loads((p/'diag.json').read_text());fs=m['families'];kept={f['id']for f in fs if f['kept']}
+ reached={s for f,s in m['uses']if f in kept};pending=list(reached)
+ while pending:
+  for s in m['systems'][pending.pop()]['systems']:
+   if s not in reached:reached.add(s);pending.append(s)
+ ds={};refs=set();wrappers=collections.defaultdict(list)
+ with(p/'diag.ast.jsonl').open()as stream:
+  for line in stream:
+   if line.startswith('{"event":"decl"'):
+    d=json.loads(line)
+    if d['category']=='binding':wrappers[d['key']].append(d)
+    if d['category']!='free'or d['implicit']or d['local']or d['owner']not in kept or d['kind']in ['deduction guide','operator()']or '(lambda)'in d['name']:continue
+    f=fs[d['owner']]
+    if f['memberOf']!=NO or(f['kind']==1 and(f['root']or f['pin']))or d['name']=='main':continue
+    k=d['key']
+    if k not in ds:ds[k]=dict(d)
+    else:
+     ds[k]['used']|=d['used'];ds[k]['referenced']|=d['referenced'];ds[k]['begin']=min(ds[k]['begin'],d['begin']);ds[k]['end']=max(ds[k]['end'],d['end'])
+   elif line.startswith('{"event":"ref"'):
+    e=json.loads(line)
+    if e['from']in kept or(e['from']==NO and e['sys']in reached):refs.add(e['key'])
+ text=m['text'].encode();starts=[0]+[x.end()for x in re.finditer(b'\n',text)];candidates=[]
+ for k,d in ds.items():
+  if k in refs or d['used']or d['referenced']:continue
+  a,b=d['begin'],d['end']
+  for w in wrappers[k]:
+   if w['owner']==d['owner']and w['begin']<=a and w['end']>=b:a=w['begin']
+  if text[b:b+1]==b';':b+=1
+  spans=[]
+  for x,y in fs[d['owner']]['ranges']:
+   lo=max(a,x);hi=min(b,y)
+   if lo<hi:spans.append([lo,hi])
+  if fs[d['owner']]['kind']==1:spans=fs[d['owner']]['ranges']
+  size=sum(y-x for x,y in spans)
+  if not size:continue
+  li=bisect.bisect_right(starts,k)-1;loc=m['lines'][li];where=loc[0].split('/include/')[-1]+':'+str(loc[1])if loc else str(k)
+  candidates.append(dict(key=k,owner=d['owner'],name=d['name'],location=where,bytes=size,ranges=spans,kind=d['kind']or'free function'))
+ total+=sum(d['bytes']for d in candidates);count+=len(candidates);(p/'free-candidates.json').write_text(json.dumps(candidates))
+print('unused free declarations',count,'owned bytes',total)
