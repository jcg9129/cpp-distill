+for n,c in sorted(eligible):text+=f'| {n} | {fmt(next(r["bytes"]for r in results if r["name"]==n))} | {fmt(c["bytes"])} | {fmt(c["gain"])} | {"pass"if c.get("sample")else"FAIL"} |\n'
