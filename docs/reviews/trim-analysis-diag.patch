+#include <fstream>
+#include <iostream>
+namespace distill { Result<PruningResult> trimRetention(const PruningModel&); }
+int main(int argc,char**argv){
+ using namespace distill;if(argc!=4&&argc!=5)return 2;
+ std::ifstream in(argv[1]);std::string bytes{std::istreambuf_iterator<char>(in),{}};
+ auto parsed=parsePruningModel(bytes);if(!parsed.ok())return 3;auto m=std::move(parsed.value());auto old=computeRetention(m);if(!old.ok())return 4;
+ m.libraryMemberNames.clear();std::ifstream names(argv[2]);std::string line;while(std::getline(names,line))m.libraryMemberNames.insert(line);
+ auto rr=trimRetention(m);if(!rr.ok())return 5;auto&r=rr.value();std::ofstream o(argv[3]);
+ o<<"{\"disabled\":";trim::strs(o,r.disabledReasons);o<<",\"freed\":[";bool first=true;
+ for(std::size_t i=0;i<m.families.size();++i)if(old.value().families[i].kept&&!r.families[i].kept){if(!first)o<<',';first=false;o<<i;}o<<']';
+ if(r.disabledReasons.empty()) {auto rendered=renderSource(m,&r,true);if(rendered.ok()){auto unmarked=withoutLineMarkers(rendered.value());if(unmarked.ok()){o<<",\"bytes\":"<<unmarked.value().size();if(argc==5){std::ofstream file(argv[4]);file<<unmarked.value();}}}}
+ o<<'}';return 0;
+}
