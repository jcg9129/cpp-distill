+inline std::string q(std::string_view s) {
+ std::string o="\""; const char* hex="0123456789abcdef";
+ for(unsigned char c:s) { if(c=='"'||c=='\\') {o+='\\';o+=c;} else if(c<32) {o+="\\u00";o+=hex[c>>4];o+=hex[c&15];} else o+=c; } return o+'"';
+}
+inline std::string prefix(){ const char* p=std::getenv("DISTILL_TRIM_PREFIX");return p?p:""; }
+inline void ranges(std::ostream& o,const std::vector<EditRange>& rs){o<<'[';bool first=true;for(auto r:rs){if(!first)o<<',';first=false;o<<'['<<r.begin<<','<<r.end<<']';}o<<']';}
+template<class T> inline void nums(std::ostream&o,const T&v){o<<'[';bool first=true;for(auto x:v){if(!first)o<<',';first=false;o<<x;}o<<']';}
+template<class T> inline void strs(std::ostream&o,const T&v){o<<'[';bool first=true;for(auto x:v){if(!first)o<<',';first=false;o<<q(x);}o<<']';}
+inline void dump(const PruningModel&m,const PruningResult&r){
+ auto p=prefix();if(p.empty())return;
+ std::ofstream proto(p+".model");auto encoded=serializePruningModel(m);if(encoded.ok())proto<<encoded.value();
+ std::ofstream o(p+".json");o<<"{\"text\":"<<q(m.text)<<",\"disabled\":";strs(o,r.disabledReasons);
+ o<<",\"memberDisabled\":";strs(o,r.memberDisabledReasons);o<<",\"families\":[";
+ for(std::size_t i=0;i<m.families.size();++i){if(i)o<<',';auto&f=m.families[i];auto&k=r.families[i];
+ o<<"{\"id\":"<<i<<",\"kind\":"<<int(f.kind)<<",\"label\":"<<q(f.label)<<",\"memberOf\":"<<f.memberOf<<",\"memberName\":"<<q(f.memberName)<<",\"blocker\":"<<q(f.memberBlocker)<<",\"ranges\":";ranges(o,f.ranges);
+ o<<",\"edges\":";nums(o,f.edges);o<<",\"deps\":";strs(o,f.dependentNames);o<<",\"names\":";strs(o,f.names);
+ o<<",\"root\":"<<q(f.root)<<",\"pin\":"<<q(f.pinned)<<",\"never\":"<<q(f.neverRemoved)<<",\"effect\":"<<q(f.instantiationEffect)<<",\"kept\":"<<k.kept<<",\"reason\":"<<q(k.reason)<<",\"cause\":"<<k.cause<<'}';}
+ o<<"],\"unions\":[";bool first=true;for(auto[a,b]:m.unions){if(!first)o<<',';first=false;o<<'['<<a<<','<<b<<']';}
+ o<<"],\"systems\":[";first=true;for(auto&s:m.systemEntities){if(!first)o<<',';first=false;o<<"{\"label\":"<<q(s.label)<<",\"users\":";nums(o,s.userEdges);o<<",\"systems\":";nums(o,s.systemEdges);o<<'}';}
+ o<<"],\"uses\":[";first=true;for(auto s:m.systemUses){if(!first)o<<',';first=false;o<<'['<<s.family<<','<<s.entity<<']';}
+ o<<"],\"lines\":[";first=true;for(auto s:m.lineMap){if(!first)o<<',';first=false;if(s)o<<'['<<q(s->file)<<','<<s->line<<']';else o<<"null";}
+ o<<"],\"directives\":";ranges(o,m.sourceDirectives);o<<",\"markers\":";ranges(o,m.generatedMarkers);o<<",\"library\":";strs(o,m.libraryMemberNames);
+ o<<",\"tokens\":[";auto ts=pruningIdentifiers(m.text);first=true;if(ts.ok())for(auto&t:ts.value()){if(!first)o<<',';first=false;o<<'['<<t.begin<<','<<t.end<<','<<q(t.text)<<']';}o<<"]}";
+}
