+ model=json.loads((p/'diag.json').read_text());rend=json.loads((p/'diag.render.json').read_text());marked=rend['text'].encode();positions=array.array('i',[-1])*len(marked)
+ for a,b,to in rend['copied']:positions[to:to+b-a]=array.array('i',range(a,b))
+ if actual!=marked:
+  keep=[];start=0
