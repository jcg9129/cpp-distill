+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Standalone G1 deletion checks after generation/replay; <=2 examples."""
+import pathlib,json,subprocess,os,resource,concurrent.futures,time,sys,collections
+R=pathlib.Path.cwd();O=R/'measurements/trim';env=dict(os.environ,TMPDIR=str(R/'.checks/free/tmp'));env.pop('DISTILL_TRIM_PREFIX',None)
+def limit():resource.setrlimit(resource.RLIMIT_AS,(2500000*1024,2500000*1024))
+paths=[]
+for f in O.glob('*/free-analysis.json'):
+ r=json.loads(f.read_text())
+ if any(d['group']=='G1' for d in r['pool']):paths.append((sum(d['bytes'] for d in r['pool'] if d['group']=='G1'),f.parent))
+# Prioritize largest deletion groups and newly represented source declarations.
+paths.sort(reverse=True);jobs=[];covered=set()
+for gain,p in paths:
+ ds=json.loads((p/'free-analysis.json').read_text())['pool'];keys={(d['location'],d['name']) for d in ds if d['group']=='G1'}
+ if keys-covered:jobs.append((gain,p));covered|=keys
+if '--all' in sys.argv:jobs=paths
+elif '--top15' in sys.argv:
+ ids={p for g,p in jobs};jobs+= [(g,p) for g,p in paths[:15] if p not in ids]
+def run(job):
+ gain,p=job;start=time.monotonic();s=json.loads((p/'summary.json').read_text());source=pathlib.Path(s['source']);out=p/'g1.cpp';binary=p/'g1.bin';row=dict(example=p.name,ownedGain=gain,passCheck=False)
+ with (p/'g1-check.log').open('w') as log:
+  try:
+   # Check the compact candidate too without another compiler invocation: this
+   # transformation independently verifies full tokens/directive boundaries.
+   c=subprocess.run([str(R/'.checks/free/artifacts'),str(out)],env=env,stdout=subprocess.PIPE,stderr=log,timeout=30,preexec_fn=limit)
+   row['compactInvariant']=c.returncode==0
+   if c.returncode==0:
+    row['compactBytes']=json.loads(c.stdout)['bytes']
+    c=subprocess.run([str(R/'.checks/free/g++13'),'-std=c++23','-O2','-x','c++',str(out)+'.compact','-o',str(binary)],env=env,stdout=log,stderr=subprocess.STDOUT,timeout=120,preexec_fn=limit)
+    row['compile']=c.returncode
+    if c.returncode==0:
+     inp=source.with_suffix('.in').read_bytes() if source.with_suffix('.in').exists() else b''
+     q=subprocess.run([str(R/'.checks/trim/cross/sysroot2/usr/bin/qemu-x86_64'),'-L',str(R/'.checks/trim/cross/sysroot2/usr/x86_64-linux-gnu'),str(binary)],input=inp,stdout=subprocess.PIPE,stderr=log,env=env,timeout=30,preexec_fn=limit)
+     row['passCheck']=q.returncode==0 and q.stdout==source.with_suffix('.out').read_bytes()
+  except subprocess.TimeoutExpired:row['timeout']=True
+ binary.unlink(missing_ok=True);row['seconds']=round(time.monotonic()-start,1);(p/'g1-check.json').write_text(json.dumps(row));return row
+with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
+ for row in pool.map(run,jobs):print(json.dumps(row),flush=True)
+print('Distinct written G1 declarations covered',len(covered),'example checks',len(jobs),flush=True)
