+#include "core/prune/prune.h"
+#include <fstream>
+#include <iostream>
+#include <algorithm>
+using namespace distill;
+std::string read(char*p){std::ifstream f(p);return {std::istreambuf_iterator<char>(f),{}};}
+int main(int argc,char**argv){if(argc!=4)return 2;auto p=parsePruningModel(read(argv[2]));if(!p.ok())return 3;auto m=std::move(p.value());if(std::string(argv[1])=="prepare"){
+ m.families.clear();m.unions.clear();m.annotations.clear();m.expansions.clear();m.systemEntities.clear();m.systemUses.clear();m.parseWidths.reset();m.positionUses.clear();m.memberDisabledReasons.clear();m.libraryMemberNames.clear();m.libraryMemberNamesComputed=false;
+ auto bytes=serializePruningModel(m);if(!bytes.ok())return 4;std::ofstream f(argv[3]);f<<bytes.value();return 0;}
+ auto q=parsePruningModel(read(argv[3]));if(!q.ok())return 5;auto normalize=[](PruningModel&x){
+ auto unique=[](auto&v){std::sort(v.begin(),v.end());v.erase(std::unique(v.begin(),v.end()),v.end());};
+ for(auto&f:x.families){unique(f.edges);unique(f.associatedTypes);}
+ for(auto&e:x.systemEntities){unique(e.userEdges);unique(e.systemEdges);}
+ for(auto&u:x.unions)if(u.first>u.second)std::swap(u.first,u.second);unique(x.unions);
+ std::sort(x.systemUses.begin(),x.systemUses.end(),[](auto a,auto b){return std::tie(a.family,a.entity)<std::tie(b.family,b.entity);});
+ x.systemUses.erase(std::unique(x.systemUses.begin(),x.systemUses.end(),[](auto a,auto b){return a.family==b.family&&a.entity==b.entity;}),x.systemUses.end());
+ };normalize(m);normalize(q.value());
+ auto a=serializePruningModel(m);auto b=serializePruningModel(q.value());if(!a.ok()||!b.ok())return 6;
+ if(a.value()!=b.value()){std::size_t i=0;while(i<a.value().size()&&i<b.value().size()&&a.value()[i]==b.value()[i])++i;std::cerr<<"model mismatch at byte "<<i<<"\noriginal="<<a.value().substr(i,250)<<"\nreplay="<<b.value().substr(i,250)<<'\n';return 7;}return 0;}
