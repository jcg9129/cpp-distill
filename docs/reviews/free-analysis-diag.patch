+# SPDX-License-Identifier: GPL-3.0-or-later
+import pathlib,json,re,collections,hashlib,subprocess
+R=pathlib.Path.cwd();O=R/'measurements/trim';rs=[json.loads(p.read_text()) for p in O.glob('*/free-analysis.json')];ss=[json.loads(p.read_text()) for p in O.glob('*/summary.json')]
+assert len(rs)==len(ss)==126,(len(rs),len(ss))
