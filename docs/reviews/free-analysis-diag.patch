+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Comparable earlier lexical-only pool, before the new effect barrier."""
+import pathlib,json,array,re
+O=pathlib.Path('measurements/trim')
+for p in O.glob('*/free-analysis.json'):
+ r=json.loads(p.read_text())
+ if 'legacyClosed' in r:continue
+ ds=r['pool'];blocked={i for i,d in enumerate(ds) if d['group']=='blocked c/d'}
+ if not blocked:
+  closed=[d for d in ds if d['group'] in ['G1','G2','G4']];r['legacyClosed']=dict(declarations=len(closed),nlm=sum(d['bytes'] for d in closed),compact=sum(d['compact'] for d in closed));r['effectClosed']=dict(declarations=0,nlm=0,compact=0)
+ else:
+  m=json.loads((p.parent/'diag.json').read_text());n=len(m['text'].encode());owner=array.array('i',[-1])*n;alive=array.array('b',[1])*n
+  for f in m['families']:
+   if not f['kept']:
+    for a,b in f['ranges']:alive[a:b]=array.array('b',[0])*(b-a)
+  for i,d in enumerate(ds):
+   for a,b in d['ranges']:owner[a:b]=array.array('i',[i])*(b-a)
+  ts=[(a,name) for a,b,name in m['tokens'] if alive[a]]
+  for l in (p.parent/'diag.ast.jsonl').open():
+   e=json.loads(l)
+   if e['event']=='token' and e['at']<n and alive[e['at']]:ts.append((e['at'],e['name']))
+  s=set(range(len(ds)))
+  while True:
+   ext={name for at,name in ts if owner[at] not in s};z={i for i in s if not re.fullmatch(r'[A-Za-z_][A-Za-z_0-9]*',ds[i]['simple']) or ds[i]['simple'] not in ext}
+   if z==s:break
+   s=z
+  def stats(ids):return dict(declarations=len(ids),nlm=sum(ds[i]['bytes'] for i in ids),compact=sum(ds[i]['compact'] for i in ids))
+  r['legacyClosed']=stats(s);r['effectClosed']=stats(s&blocked)
+ p.write_text(json.dumps(r))
+print('legacy closure updated')
