# SPDX-License-Identifier: GPL-3.0-or-later
# Release documents are copied byte-for-byte into both tarballs and Windows zips.
# Keep their committed LF bytes, including the checksum-verified notices.
/LICENSE -text
/README.md -text
/THIRD_PARTY_NOTICES.md -text
/LLVM-LICENSE.txt -text

# Build-time policy digests must also be identical on every platform.
/data/names/adl.txt -text
/data/names/extension-coverage.txt -text

# Profile content digests include exact TOML and snapshot bytes.
/data/judges/*.toml -text
/data/judges/*-predefined.txt -text

# Probe fixtures must retain their exact captured bytes on every platform.
tests/unit/fixtures/** -text

# Inliner fixtures include CRLF, BOM and missing-final-newline cases.
tests/cases/inline/** -text

# Resolver fixtures preserve directive and source line coordinates.
tests/cases/resolve/** -text

# Pipeline commands, expectations and source bytes are platform-independent.
tests/cases/pipeline/** -text
tests/cases/pipeline/crlf/main.cpp whitespace=cr-at-eol
