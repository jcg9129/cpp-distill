+					out2[j] = (qa * rhs[j]).conj();
+				}
+				fft(out1);
+				fft(out2);
+				for (std::size_t i = 0, valid = (std::min)(size, len + shortest - 1); i < valid; ++i) {
+					int64 const ll = std::llround(out1[i].re * inv);
