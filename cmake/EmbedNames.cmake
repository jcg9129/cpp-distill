# Included at configure time; CMAKE_CONFIGURE_DEPENDS tracks edits to the data.
set(names_source "// SPDX-License-Identifier: GPL-3.0-or-later\n#include <string_view>\n#include <cstddef>\nnamespace distill::embedded {\n")
foreach(kind headers macros)
  set(input "${CMAKE_CURRENT_SOURCE_DIR}/data/names/standard-${kind}.txt")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
  file(STRINGS "${input}" entries REGEX "^[^# \t].*")
  list(REMOVE_DUPLICATES entries)
  list(SORT entries)
  string(APPEND names_source "extern const std::string_view ${kind}[] = {\n")
  foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^[a-zA-Z0-9_./+]+$")
      message(FATAL_ERROR "Invalid name in ${input}: ${entry}")
    endif()
    string(APPEND names_source "  \"${entry}\",\n")
  endforeach()
  string(APPEND names_source "};\nextern const std::size_t ${kind}Count = sizeof(${kind}) / sizeof(${kind}[0]);\n")
endforeach()
# Individual names avoid MSVC's string-literal size limit for large inventories.
set(extension_index 0)
foreach(library glibc libstdc++ mingw-w64 macos-libc)
  set(input "${CMAKE_CURRENT_SOURCE_DIR}/data/extensions/${library}.txt")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
  file(STRINGS "${input}" entries REGEX "^[^#].*")
  string(APPEND names_source "const std::string_view extensions${extension_index}[] = {\n  \"\",\n")
  foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
      message(FATAL_ERROR "Invalid extension name in ${input}: ${entry}")
    endif()
  endforeach()
  if(entries)
    list(JOIN entries "\",\n  \"" joined_entries)
    string(APPEND names_source "  \"${joined_entries}\",\n")
  endif()
  string(APPEND names_source "};\n")
  math(EXPR extension_index "${extension_index} + 1")
endforeach()
string(APPEND names_source "const std::string_view* extensionData(std::size_t index) {\nswitch (index) {\n")
foreach(index RANGE 0 3)
  string(APPEND names_source "case ${index}: return extensions${index} + 1;\n")
endforeach()
string(APPEND names_source "default: return nullptr;\n}\n}\nstd::size_t extensionCount(std::size_t index) {\nswitch (index) {\n")
foreach(index RANGE 0 3)
  string(APPEND names_source "case ${index}: return sizeof(extensions${index}) / sizeof(extensions${index}[0]) - 1;\n")
endforeach()
string(APPEND names_source "default: return 0;\n}\n}\n}\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/embedded_names.cpp" "${names_source}")

# A6 and extension eligibility are immutable build-time policy data.
foreach(kind adl extension-coverage)
  set(input "${CMAKE_CURRENT_SOURCE_DIR}/data/names/${kind}.txt")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
  file(READ "${input}" content)
  file(SHA256 "${input}" digest)
  if(kind STREQUAL "adl")
    set(symbol adl)
  else()
    set(symbol extensionCoverage)
  endif()
  file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/embedded_names.cpp"
    "namespace distill::embedded { extern const std::string_view ${symbol} = R\"DISTILL(${content})DISTILL\"; }\n")
  if(kind STREQUAL "adl")
    file(APPEND "${CMAKE_CURRENT_BINARY_DIR}/embedded_names.cpp"
      "namespace distill::embedded { extern const std::string_view adlDigest = \"sha256:${digest}\"; }\n")
  endif()
endforeach()
